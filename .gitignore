# Atlas project binding — local, not shared
.atlas.toml

# Claude Code local settings
.claude/settings.local.json

# Local workspace guidance — not shared
CLAUDE.local.md

# Dependencies & build output
node_modules/
dist/
# Compiled standalone binaries (built by the release workflow / `bun build --compile`)
/mimir
/mimir-*

# From-source dev store — isolated from the production store (MMR-117)
.dev/

# viteplus cache
.vite-plus/

# TypeScript incremental build info (regenerated by check/test/build)
*.tsbuildinfo

# vite-plugin-pwa dev output
packages/host/dev-dist/

# Playwright MCP scratch output (snapshots/screenshots from manual smokes)
.playwright-mcp/
# Playwright test evidence is uploaded on failure, never committed.
packages/host/playwright-report/
packages/host/test-results/
.superpowers/
.claude/saga-claude-hook.sh
.mcp.json
.saga.local.json
.codex/

# TanStack Start and Nitro build output
packages/host/.output/
packages/host/.tanstack/

# Per-worktree scratch (temp builds, fixtures, experiment output)
.scratch/
